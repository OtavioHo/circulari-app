{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "app",
      "request": "launch",
      "type": "dart",
      // RevenueCat public SDK keys are compile-time (String.fromEnvironment).
      // Without this the SDK gets no key and subscriptions are disabled.
      "toolArgs": ["--dart-define-from-file=${workspaceFolder}/dart_defines.json"]
    },
    {
      "name": "app (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "toolArgs": ["--dart-define-from-file=${workspaceFolder}/dart_defines.json"]
    },
    {
      "name": "app (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "toolArgs": ["--dart-define-from-file=${workspaceFolder}/dart_defines.json"]
    },
    {
      "name": "widgetbook",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/packages/circulari_widgetbook/lib/main.dart",
      "cwd": "${workspaceFolder}/packages/circulari_widgetbook"
    }
  ]
}
